# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app

RUN npm install --global pnpm@10.11.1

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/storefront/package.json ./apps/storefront/package.json

RUN pnpm install --frozen-lockfile

COPY . .

ARG NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_MEDUSA_BACKEND_URL
ARG NEXT_PUBLIC_BASE_URL
ARG NEXT_PUBLIC_DEFAULT_REGION

ENV NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=$NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_MEDUSA_BACKEND_URL=$NEXT_PUBLIC_MEDUSA_BACKEND_URL
ENV NEXT_PUBLIC_BASE_URL=$NEXT_PUBLIC_BASE_URL
ENV NEXT_PUBLIC_DEFAULT_REGION=$NEXT_PUBLIC_DEFAULT_REGION

RUN pnpm --filter @dtc/storefront build

RUN test -x /app/apps/storefront/node_modules/.bin/next

FROM node:22-bookworm-slim AS runner

ENV NODE_ENV="production"
ENV PORT="8000"
ENV HOSTNAME="0.0.0.0"

WORKDIR /app/apps/storefront

COPY --from=builder --chown=node:node /app/node_modules /app/node_modules
COPY --from=builder --chown=node:node /app/apps/storefront/node_modules /app/apps/storefront/node_modules
COPY --from=builder --chown=node:node /app/apps/storefront /app/apps/storefront

USER node

EXPOSE 8000

CMD ["/app/apps/storefront/node_modules/.bin/next", "start", "-p", "8000", "-H", "0.0.0.0"]
