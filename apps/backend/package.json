{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "start:server": "cross-env MEDUSA_WORKER_MODE=server medusa start",
    "start:worker": "cross-env MEDUSA_WORKER_MODE=worker medusa start",
    "start:shared": "cross-env MEDUSA_WORKER_MODE=shared medusa start",
    "dev": "medusa develop",
    "seed": "medusa exec ./src/migration-scripts/initial-data-seed.ts",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:integration:http": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "cross-env TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/admin-shared": "2.18.0",
    "@medusajs/caching": "2.18.0",
    "@medusajs/caching-redis": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/dashboard": "2.18.0",
    "@medusajs/draft-order": "2.18.0",
    "@medusajs/event-bus-redis": "2.18.0",
    "@medusajs/file-s3": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/locking-redis": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/ui": "4.2.0",
    "@medusajs/workflow-engine-redis": "2.18.0",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-query": "5.64.2",
    "cross-env": "10.1.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.4",
    "resend": "^6.18.1",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.18.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
