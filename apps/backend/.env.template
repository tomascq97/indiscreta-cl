NODE_ENV=development
# Development uses a single process. Production must set this explicitly to shared, server, or worker.
MEDUSA_WORKER_MODE=shared
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7001,http://localhost:8000
# Optional in development and test. Production requires a redis: or rediss: URL.
# Local example: redis://localhost:6379
REDIS_URL=
# Enable with Redis. Production requires this feature flag to be true.
MEDUSA_FF_CACHING=false
JWT_SECRET=replace-with-a-secure-random-value
COOKIE_SECRET=replace-with-a-secure-random-value
DATABASE_URL=postgresql://user:password@localhost:5432/database
# Optional in development/test; production requires all five values.
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
# Optional for S3-compatible APIs. Set path style to true only with an endpoint.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=

# Webpay Plus. Leave all five empty in development when Webpay is disabled.
# WEBPAY_ENVIRONMENT accepts only integration or production.
# Production requires all five values and HTTPS return/result URLs.
WEBPAY_ENVIRONMENT=
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY_SECRET=
WEBPAY_RETURN_URL=
WEBPAY_RESULT_URL=

# Shipit remains fully disabled until explicitly enabled. Credentials are backend-only.
SHIPIT_ENABLED=false
SHIPIT_SHIPMENT_CREATION_ENABLED=false
# Keep true through staging. Set false only in a reviewed production deployment.
SHIPIT_SANDBOX=true
SHIPIT_API_BASE_URL=https://api.shipit.cl
SHIPIT_PRICES_BASE_URL=https://prices.shipit.cl
SHIPIT_TRACKING_BASE_URL=https://courierstatus.shipit.cl
SHIPIT_EMAIL=
SHIPIT_ACCESS_TOKEN=
# Dedicated Bearer token configured in Shipit's webhook settings.
SHIPIT_WEBHOOK_TOKEN=
SHIPIT_ORIGIN_COMMUNE_ID=
SHIPIT_TIMEOUT_MS=5000
SHIPIT_READ_MAX_RETRIES=1
SHIPIT_QUOTE_MAX_AGE_SECONDS=900
SHIPIT_CATALOG_CACHE_TTL_SECONDS=21600
# Shipit rates are net. INDISCRETA adds 19% IVA and charges the gross CLP total.
SHIPIT_RATES_ARE_NET=true
