NODE_ENV=development
# Development uses a single process. Production must set this explicitly to shared, server, or worker.
MEDUSA_WORKER_MODE=shared
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7001,http://localhost:8000
# Optional in development and test. Production requires a redis: or rediss: URL.
# Local example: redis://localhost:6379
REDIS_URL=
# Enable with Redis. Production requires this feature flag to be true.
MEDUSA_FF_CACHING=false
JWT_SECRET=replace-with-a-secure-random-value
COOKIE_SECRET=replace-with-a-secure-random-value
DATABASE_URL=postgresql://user:password@localhost:5432/database
# Optional in development/test; production requires all five values.
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
# Optional for S3-compatible APIs. Set path style to true only with an endpoint.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
