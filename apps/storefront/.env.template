# Required Medusa storefront connection
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=replace-with-a-publishable-key
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Required in production; optional in development
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Optional storefront settings
NEXT_PUBLIC_VERCEL_URL=

# Optional Stripe provider
NEXT_PUBLIC_STRIPE_KEY=

# Optional Medusa Payments provider; configure both variables together
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# Optional Medusa Cloud images; configure both variables together
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

# Runtime environment
NODE_ENV=development
